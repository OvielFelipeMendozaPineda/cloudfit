# CloudFit API — copy to .env and fill in. .env is gitignored: never commit real keys.
# Defaults live in src/main/resources/application.yaml; anything left empty here uses them.

# ── App ───────────────────────────────────────────────────────────────────────
# dev → enables CORS for http://localhost:5173 and PAYMENTS_MODE=fake by default
APP_ENV=dev
# Public URL of the front (used for CORS and for the links in emails / checkout returns)
APP_URL=http://localhost:5173
PORT=8080
# true when running behind a proxy/tunnel (nginx, Cloudflare) so rate limits use the real client IP
TRUST_PROXY=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_LOOKS_PER_MINUTE=6

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudfit
DB_USER=cloudfit
DB_PASSWORD=change-me
# DB_MAX_POOL_SIZE=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED, at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=
# JWT_KEY_ID=v1
# Refresh cookie `Secure` flag: true in prod (HTTPS), false for plain-http local dev
COOKIE_SECURE=false
# Leave empty to disable the provider (/auth/providers returns null, /auth/<provider> → 501)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# ── Email ─────────────────────────────────────────────────────────────────────
# Without SMTP_HOST, emails (verification / reset links) are printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=CloudFit <no-reply@cloudfit.app>

# ── Gemini (stylist, tagger, image) ───────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# CLOUDFIT_STYLIST_MODEL=gemini-3.6-flash
# CLOUDFIT_TAGGER_MODEL=gemini-3.6-flash
# CLOUDFIT_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Images ────────────────────────────────────────────────────────────────────
# local → files in IMAGES_DIR served at /api/v1/images/{key}; s3 → public bucket URLs
IMAGE_STORE=local
IMAGES_DIR=./data/images
# Only for IMAGE_STORE=s3
AWS_S3_BUCKET=
AWS_REGION=us-east-2
# Standard AWS SDK env vars — picked up by the SDK, not by our config code.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Wardrobe ──────────────────────────────────────────────────────────────────
# Optional: without it POST /remove-bg answers 501
REMOVE_BG_API_KEY=
# Max clothes without an active plan
FREE_MAX_CLOTHES=30
# MAX_UPLOAD_BYTES=10485760

# ── Billing ───────────────────────────────────────────────────────────────────
# fake → checkout credits instantly (dev). live → real providers (501 if their keys are missing).
PAYMENTS_MODE=fake
# SIGNUP_BONUS_CREDITS=5
# ADS_DAILY_MAX=3

# Stripe (rest of the world: packs + plans in USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional recurring Price ids; without them the checkout uses inline price_data
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# Wompi (Colombia: packs in COP)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox
