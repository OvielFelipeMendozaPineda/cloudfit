# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults live in application.yaml):
# CLOUDFIT_STYLIST_MODEL=gemini-3.6-flash
# CLOUDFIT_TAGGER_MODEL=gemini-3.6-flash
# CLOUDFIT_IMAGE_MODEL=gemini-3.6-flash-image
# PORT=8080

# RDS MySQL
DB_HOST=cloudfit-db.xxxxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=cloudfit
DB_USER=admin
DB_PASSWORD=your-rds-password-here

# S3 (image storage)
AWS_S3_BUCKET=cloudfit-images-yourorg
AWS_REGION=us-east-2
# Standard AWS SDK env vars — picked up automatically, not read by our own config code.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
